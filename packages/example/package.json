{
  "name": "ssr-kit-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test",
    "clean": "rm -rf dist test-results playwright-report",
    "prerender": "ssr-kit-prerender --entry dist/server/entry.js --out dist/prerendered / /about /gold/1",
    "demo:dev": "wrangler dev --port 4600",
    "demo:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssr-kit": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "wrangler": "^4.160.0"
  }
}
