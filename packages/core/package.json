{
  "name": "ssr-kit",
  "version": "0.1.1",
  "description": "React 19 streaming SSR as one middleware for the Node server you already have. Vite 8 plugin, adapters for Express, Fastify, Hono, and Cloudflare Workers.",
  "keywords": [
    "react",
    "ssr",
    "streaming",
    "server-side-rendering",
    "vite",
    "vite-plugin",
    "express",
    "hono",
    "fastify",
    "cloudflare-workers",
    "react-19"
  ],
  "homepage": "https://github.com/Ahnseungc/ssr-kit#readme",
  "bugs": {
    "url": "https://github.com/Ahnseungc/ssr-kit/issues"
  },
  "license": "MIT",
  "author": "안승찬",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahnseungc/ssr-kit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./prerender": {
      "types": "./dist/prerender.d.ts",
      "default": "./dist/prerender.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "default": "./dist/edge.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "size": "node scripts/check-size.mjs",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.158.0"
  },
  "peerDependencies": {
    "fastify": "^5",
    "hono": "^4",
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "hono": "^4.13.17",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ssr-kit-prerender": "bin/ssr-kit-prerender.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
