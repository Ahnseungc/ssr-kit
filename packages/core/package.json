{
  "name": "ssr-kit",
  "version": "0.0.0",
  "description": "Node 서버에 미들웨어로 붙는 React 19 스트리밍 SSR 플러그인",
  "license": "MIT",
  "author": "안승찬",
  "repository": { "type": "git", "url": "git+https://github.com/Ahnseungc/ssr-kit.git", "directory": "packages/core" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./vite": { "types": "./dist/vite.d.ts", "default": "./dist/vite.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.158.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": { "node": ">=22" }
}
