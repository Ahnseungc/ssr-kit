{
  "name": "ssr-kit-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter ssr-kit build",
    "test": "pnpm --filter ssr-kit test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "example:build": "pnpm --filter ssr-kit-example build",
    "e2e": "pnpm --filter ssr-kit-example e2e",
    "clean": "pnpm -r clean",
    "publish:ssr-kit": "pnpm --filter ssr-kit publish --access public",
    "format": "prettier --write \"packages/*/{src,test,e2e}/**/*.{ts,tsx}\" \"packages/*/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@10.28.0"
}
